# Server Settings (Local)
server.port=8081

# Database (Local - MySQL)
# Copy this file to application-local.properties and fill in your own local credentials.
# application-local.properties is gitignored, so each machine keeps its own copy.
spring.datasource.url=jdbc:mysql://localhost:3306/myserver_dev?serverTimezone=Asia/Seoul
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=myserver
spring.datasource.password=CHANGE_ME

# Flyway: 스키마를 마이그레이션 스크립트로 관리 (Hibernate ddl-auto 대체)
# 새로 이 프로젝트를 설정하는 경우, db/migration의 스크립트가 순서대로 적용되어
# 스키마가 자동 생성된다.
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

# JPA (Local)
# Flyway가 스키마를 관리하므로 Hibernate는 엔티티-스키마 일치 여부만 검증한다.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
# SQL 로그는 logback-spring.xml의 org.hibernate.SQL DEBUG 로거 하나로만 찍는다
# (spring.jpa.show-sql은 끔 — 같이 켜두면 Hibernate가 콘솔에 중복으로 또 찍어서 로그가 두 번씩 나왔음)
spring.jpa.properties.hibernate.format_sql=true
